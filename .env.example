# FRNC 환경변수 예시 — 실제 값은 .env(비커밋) 또는 배포 환경변수로만 넣습니다.

# 공정거래위원회 가맹정보 오픈API 인증키(선택).
# 없으면 브랜드 조회가 내장 샘플(data_state=sample)로 동작하고, 판정 자체는 그대로 계산됩니다.
# 활용신청이 필요한 데이터셋과 신청 주소는 api-verification-*.json 의 apply_urls 를 보세요.
DATA_GO_KR_SERVICE_KEY=

# 법제처 OPEN API OC 값 — law-verification.json 을 다시 만들 때만 씁니다(서버는 쓰지 않음).
LAW_GO_KR_OC=

# 서버
PORT=8787
HOST=0.0.0.0
PUBLIC_BASE_URL=http://localhost:8787

# 저장소
FRNC_DB=data/app.sqlite
# 익명 카운터만 따로 둘 경로(영속 디스크). 비어 있으면 FRNC_DB 를 씁니다.
FRNC_STATS_PATH=

# 검색엔진 소유확인(선택) — 비어 있으면 메타태그도 확인 파일도 나가지 않습니다.
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=
SITE_VERIFICATION_FILES=

# 요청 제한(선택) — 클라이언트당 고정 창. 0이면 그 축은 끕니다.
# IP 는 저장하지 않고 프로세스 난수로 해시한 메모리 키만 씁니다(재배포 시 초기화).
FRNC_RATE_LIMIT_PER_MINUTE=240
FRNC_RATE_WRITE_PER_MINUTE=30
FRNC_RATE_WINDOW_SECONDS=60

# 문의 알림·이중 기록(선택)
# 무료 플랜은 재시작 때 DB 가 초기화되므로, 아래 둘 중 하나를 두면 문의를 일어버리지 않습니다.
# 웹훅 기본 본문에는 연락처를 넣지 않습니다(접수번호·유형·미리보기만).
FRNC_INQUIRY_WEBHOOK_URL=
FRNC_INQUIRY_WEBHOOK_CONTACT=
# 영구 볼륨을 붙였을 때만 의미가 있습니다(예: /var/data/inquiries.jsonl). 서버가 뜰 때 DB 로 복구합니다.
FRNC_INQUIRY_MIRROR=

# 문의 조회(GET /v1/inquiries) 토큰 — 비어 있으면 그 경로는 404 입니다.
FRNC_ADMIN_TOKEN=
